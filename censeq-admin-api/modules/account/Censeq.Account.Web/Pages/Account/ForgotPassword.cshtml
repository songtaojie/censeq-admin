@page "/account/forgot-password"
@inject IHtmlLocalizer<AccountResource> L
@using Microsoft.AspNetCore.Mvc.Localization
@using Censeq.Account.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Theming
@model Censeq.Account.Web.Pages.Account.ForgotPasswordModel
@inject IThemeManager ThemeManager
@{
    Layout = ThemeManager.CurrentTheme.GetAccountLayout();
}
@section styles {
    <link rel="stylesheet" href="~/libs/starshine/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/libs/starshine/css/login.bg.css" asp-append-version="true" />
    <style>
        /* ===== Forgot Password — 单卡片居中，极光主题延伸 ===== */
        .fp-scene {
            position: relative;
            width: 100%; min-height: 100vh;
            display: flex; align-items: center; justify-content: center;
            z-index: 1; padding: 2rem 1rem;
        }

        .fp-wrapper {
            display: flex; flex-direction: column; align-items: center;
            animation: cardReveal 0.8s cubic-bezier(0.16,1,0.3,1) both;
        }

        /* 顶部图标徽章 */
        .fp-badge {
            position: relative;
            width: 5rem; height: 5rem;
            margin-bottom: -2.5rem; z-index: 2;
        }

        .fp-badge-inner {
            width: 100%; height: 100%;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(120,90,220,0.9), rgba(233,69,96,0.8));
            backdrop-filter: blur(12px);
            display: flex; align-items: center; justify-content: center;
            box-shadow:
                0 0 0 1px rgba(255,255,255,0.25),
                0 8px 32px rgba(120,90,220,0.5),
                0 0 60px rgba(233,69,96,0.2);
            animation: iconFloat 5s ease-in-out infinite;
        }

        .fp-badge-inner svg {
            width: 2rem; height: 2rem;
            fill: none; stroke: #fff;
            stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round;
        }

        /* 脉冲环 */
        .fp-badge-ring {
            position: absolute; inset: -10px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,0.2);
            animation: fpRingExpand 2.4s ease-out infinite;
        }
        .fp-badge-ring:nth-child(2) {
            inset: -20px;
            border-color: rgba(233,69,96,0.15);
            animation-delay: 0.8s;
        }
        .fp-badge-ring:nth-child(3) {
            inset: -32px;
            border-color: rgba(120,90,220,0.1);
            animation-delay: 1.6s;
        }

        /* 卡片 */
        .fp-card {
            width: min(26rem, calc(100vw - 2rem));
            padding: 3.5rem 2.5rem 2.5rem;
            background: rgba(255,255,255,0.13);
            border: 1px solid rgba(255,255,255,0.25);
            border-radius: 24px;
            backdrop-filter: blur(32px) saturate(1.4);
            -webkit-backdrop-filter: blur(32px) saturate(1.4);
            box-shadow:
                0 0 0 1px rgba(255,255,255,0.08),
                0 24px 80px rgba(0,0,0,0.35),
                inset 0 1px 0 rgba(255,255,255,0.25);
            position: relative; overflow: hidden;
        }

        /* 卡片顶部扫光 */
        .fp-card::before {
            content: '';
            position: absolute; top: 0; left: -100%;
            width: 300%; height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent);
            animation: shimmerSlide 5s linear infinite;
        }

        .fp-title {
            font-size: 1.5rem; font-weight: 800;
            color: #fff; text-align: center;
            letter-spacing: -0.02em;
            margin-bottom: 0.5rem;
            text-shadow: 0 2px 20px rgba(0,0,0,0.3);
            animation: fadeSlideDown 0.6s cubic-bezier(0.16,1,0.3,1) both;
            animation-delay: 0.2s;
        }

        .fp-desc {
            font-size: 0.82rem;
            color: rgba(255,255,255,0.6);
            text-align: center;
            line-height: 1.65;
            margin-bottom: 1.75rem;
            animation: fadeSlideDown 0.6s cubic-bezier(0.16,1,0.3,1) both;
            animation-delay: 0.3s;
        }

        .fp-form { animation: fadeSlideDown 0.6s cubic-bezier(0.16,1,0.3,1) both; animation-delay: 0.4s; }

        .fp-back {
            display: flex; align-items: center; justify-content: center;
            gap: 0.4rem;
            font-size: 0.8rem;
            color: rgba(255,255,255,0.5) !important;
            text-decoration: none !important;
            margin-top: 1.25rem;
            transition: color 0.2s;
        }
        .fp-back:hover { color: rgba(255,255,255,0.85) !important; }

        .fp-divider {
            display: flex; align-items: center; gap: 0.75rem;
            margin: 1.5rem 0 0;
        }
        .fp-divider::before, .fp-divider::after {
            content: ''; flex: 1;
            height: 1px; background: rgba(255,255,255,0.12);
        }
        .fp-divider span {
            font-size: 0.7rem; letter-spacing: 0.12em;
            color: rgba(255,255,255,0.3);
            font-family: 'Courier New', monospace;
        }

        @@keyframes fpRingExpand {
            0%   { opacity: 0.7; transform: scale(1); }
            100% { opacity: 0;   transform: scale(1.8); }
        }
    </style>
}

<div class="login-container fp-scene">
    <div class="fp-wrapper">

        <!-- 浮动图标徽章 -->
        <div class="fp-badge">
            <div class="fp-badge-ring"></div>
            <div class="fp-badge-ring"></div>
            <div class="fp-badge-ring"></div>
            <div class="fp-badge-inner">
                <svg viewBox="0 0 24 24">
                    <rect x="2" y="4" width="20" height="16" rx="2"/>
                    <polyline points="2,4 12,13 22,4"/>
                </svg>
            </div>
        </div>

        <!-- 卡片 -->
        <div class="fp-card">
            <div class="fp-title">@L["ForgotPassword"]</div>
            <div class="fp-desc">@L["SendPasswordResetLink_Information"]</div>

            <form method="post" class="fp-form needs-validation" novalidate>
                <div class="login-right-warp-main">
                    <div class="mb-3">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-regular fa-envelope"></i></span>
                            <input asp-for="Email" placeholder="@Html.DisplayNameFor(m => m.Email)" class="form-control" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="d-grid mt-1">
                        <button type="submit" class="btn btn-primary" name="button">
                            @L["Submit"]
                        </button>
                    </div>
                </div>
            </form>

            <div class="fp-divider"><span>OR</span></div>

            <a asp-page="./Login"
               asp-route-returnUrl="@Model.ReturnUrl"
               asp-route-returnUrlHash="@Model.ReturnUrlHash"
               class="fp-back">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                @L["Login"]
            </a>
        </div>

    </div>
</div>
    </div>
</div>
